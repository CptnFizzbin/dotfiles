{
  "servers": {
    "mui-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mui/mcp@latest"
      ]
    },
    "tanstack": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@tanstack/cli",
        "mcp"
      ]
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    }
  }
}