[user]
    name = Captain Fizzbin
    email = code@cptnfizzbin.ca
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFLv5AKuYEfcul9uHzpyTdYCZeKx/IrW01oLZZCnBzux

[core]
    editor = vi
    autocrlf = input
    eol = lf
    sshCommand = /mnt/c/WINDOWS/System32/OpenSSH/ssh.exe

[init]
    defaultBranch = main

[gpg]
    format = ssh

[gpg "ssh"]
    program = op-ssh-sign.exe
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true

[rerere]
    enabled = true

[pull]
    rebase = true

# Per-directory identity override — copy the block and adjust the path/email
# for work repos so personal commits don't leak a work address and vice versa.
# [includeIf "gitdir:~/projects/work/"]
#     path = ~/.gitconfig.work
# ~/.gitconfig.work should contain:
#   [user]
#       email = you@company.com

# git-delta — syntax-highlighted diffs. Uncomment after: cargo install git-delta
# (or: brew install git-delta / apt install git-delta)
# [core]
#     pager = delta
# [interactive]
#     diffFilter = delta --color-only
# [delta]
#     navigate = true
#     dark = true
#     side-by-side = true
#     line-numbers = true

[include]
    path = ~/.gitconfig.local
